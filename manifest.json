{
  "manifest_version": 3,
  "name": "LightDict 轻词典",
  "version": "1.3.1",
  "description": "划词即查：选中单词看释义与音标，选中句子看翻译，还能把整个外文网页就地翻成简体中文对照。轻量、快速、不打扰。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/common/voices.js",
        "src/content/content.js",
        "src/content/page-translate.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "LightDict 轻词典",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-page": {
      "suggested_key": { "default": "Alt+T" },
      "description": "整页翻译：自动识别源语言，把当前网页译成简体中文对照"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://aidemo.youdao.com/*",
    "https://dict.youdao.com/*",
    "https://dict-mobile.iciba.com/*",
    "https://api.mymemory.translated.net/*",
    "https://simplytranslate.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://en.wiktionary.org/*",
    "https://api.datamuse.com/*"
  ]
}
